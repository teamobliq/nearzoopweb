# Firebase configuration template
# Copy this file to .env and fill in your values (Firebase console → Project settings → Your apps).
# measurementId is only needed for Google Analytics.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# imgbb image hosting — API key from https://api.imgbb.com (your account → API)
VITE_IMGBB_KEY=

# Google Maps (optional) — Maps JavaScript API key from console.cloud.google.com.
# When set, the business location step uses Google Maps; without it the map
# falls back to the keyless MapLibre + OpenFreeMap engine.
VITE_GMAPS_KEY=

# gstinapi.in GSTIN verification — key from https://www.gstinapi.in/register.
# Server-side only: the Vite dev proxy reads this (no VITE_ prefix, on
# purpose) and injects it into /gstapi requests. Direct browser calls to
# gstinapi.in are blocked by its CORS policy, so the proxy is required.
GSTIN_API_KEY=

# Razorpay (payment step) — from dashboard.razorpay.com → API Keys.
# The Key ID is public-safe and belongs in the browser. The Key SECRET is
# for server-side use only (no VITE_ prefix) and stays out of the bundle.
# Without a Key ID the payment step renders but the Pay button stays
# disabled.
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin console (/nz-admin) — Google account addresses allowed to open it,
# comma separated. EMPTY means nobody can access it.
VITE_ADMIN_EMAILS=
