rules_version = '2';

// NearZoop data model:
//   shops/{uid}                — one merchant's shop document (auth uid = doc id)
//   shops/{uid}/offers/{id}    — that merchant's offers
// Merchants sign in with phone OTP; admins sign in with Google and are
// allow-listed (mirrors VITE_ADMIN_EMAILS in .env).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Allow-list mirror of VITE_ADMIN_EMAILS. Null-guarded before the
      // string call (a method on null would itself deny), and lowercased to
      // match the app gate. Rules strings expose .lower() — NOT JavaScript's
      // toLowerCase(), which compiles but errors at evaluation time and
      // silently denies every admin read. No email_verified requirement —
      // Google accounts are verified, and a missing claim must not lock the
      // console out.
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'supritpahari123@gmail.com',
          'obliqllc@gmail.com',
        ];
    }

    match /shops/{uid} {
      allow get, list: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      // Only the merchant creates their shop; admins may update review
      // fields (verification / reviewNote) but never create or delete.
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow delete: if false;

      match /offers/{offerId} {
        allow get, list: if signedIn()
          && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid;
        // Admins may set status / reviewNote; merchants may edit their own.
        allow update: if signedIn()
          && (request.auth.uid == uid || isAdmin());
        // Removal is permanent: the owner or an admin, never anyone else.
        allow delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());
      }

      // Customer reports, filed from a shared offer link where the visitor
      // is usually signed out — so creates are open but shape-checked;
      // everything else stays owner-or-admin.
      match /reports/{reportId} {
        allow create: if request.resource.data.keys().hasAll([
          'offerId', 'offerTitle', 'reason', 'note', 'status', 'createdAt',
        ])
          && request.resource.data.offerId is string
          && request.resource.data.offerId.size() > 0
          && request.resource.data.offerId.size() < 128
          && request.resource.data.offerTitle is string
          && request.resource.data.offerTitle.size() > 0
          && request.resource.data.offerTitle.size() < 120
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() < 120
          && request.resource.data.note is string
          && request.resource.data.note.size() < 500
          && request.resource.data.status == 'open';
        allow get, list: if signedIn()
          && (request.auth.uid == uid || isAdmin());
        allow update, delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());
      }

      // The shop's inbox — written by the admin verdict actions, read and
      // marked-read by the merchant. One exception: filing a report also
      // writes its "New customer report" notification in the same batch.
      // The notification reuses the report's doc id, and its title and
      // body must be exactly the derived values, so a report can carry
      // nothing into the inbox beyond the report itself.
      match /notifications/{notificationId} {
        function pairedReport() {
          return getAfter(
            /databases/$(database)/documents/shops/$(uid)/reports/$(notificationId),
          ).data;
        }
        allow get, list: if signedIn()
          && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && (request.auth.uid == uid || isAdmin())
          || (
            request.resource.data.keys().hasAll([
              'kind', 'title', 'body', 'at', 'read',
            ])
            && request.resource.data.kind == 'report'
            && request.resource.data.title == 'New customer report'
            && request.resource.data.read == false
            && pairedReport().status == 'open'
            && pairedReport().reason is string
            && pairedReport().reason.size() > 0
            && pairedReport().offerTitle is string
            && pairedReport().offerTitle.size() > 0
            && request.resource.data.body
              == pairedReport().reason + ' · ' + pairedReport().offerTitle
          );
        allow update, delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());
      }
    }

    // Nothing outside the shops tree is reachable — and note: this wildcard
    // gates every collection-group query (it can match any candidate path),
    // so admin group reads live or die by isAdmin() right here.
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
