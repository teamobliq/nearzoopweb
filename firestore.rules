rules_version = '2';

// NearZoop data model:
//   shops/{uid}                — one merchant's shop document (auth uid = doc id)
//   shops/{uid}/offers/{id}    — that merchant's offers
// Merchants sign in with phone OTP; admins sign in with Google and are
// allow-listed (mirrors VITE_ADMIN_EMAILS in .env).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Allow-list mirror of VITE_ADMIN_EMAILS. Null-guarded before the
      // string call (a method on null would itself deny), and lowercased to
      // match the app gate. Rules strings expose .lower() — NOT JavaScript's
      // toLowerCase(), which compiles but errors at evaluation time and
      // silently denies every admin read. No email_verified requirement —
      // Google accounts are verified, and a missing claim must not lock the
      // console out.
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'supritpahari123@gmail.com',
          'obliqllc@gmail.com',
        ];
    }

    // Customer profiles — one doc per signed-in customer (auth uid = doc id).
    // Fields: name, mobile, email (optional). The customer owns their own
    // doc; admins may read all. Nothing else is reachable here.
    match /customers/{uid} {
      allow get, list: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // The customer's own record — the doc that actually carries an account's
    // data today: profile { name, phone, email, stampMs }, phoneVerified,
    // saved offers and the last area. Owner-only for reads and writes (the
    // profile editor writes here); admins may read, nobody deletes.
    match /users/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /shops/{uid} {
      allow get, list: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      // Only the merchant creates their shop; admins may update review
      // fields (verification / reviewNote) but never create or delete.
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow delete: if false;

      match /offers/{offerId} {
        allow get, list: if signedIn()
          && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid;
        // Admins may set status / reviewNote; merchants may edit their own.
        // One public exception: the shared-link landing's lifetime view
        // counter — anyone may bump `views` by exactly one and touch
        // nothing else (the day/hour buckets ride in shops/{uid}/views,
        // where the write shape can be checked properly).
        allow update: if signedIn()
          && (request.auth.uid == uid || isAdmin())
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['views'])
            && request.resource.data.views is int
            && (
              (!('views' in resource.data)
                && request.resource.data.views == 1)
              || (resource.data.views is int
                && request.resource.data.views == resource.data.views + 1)
            )
          );
        // Removal is permanent: the owner or an admin, never anyone else.
        allow delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());
      }

      // Customer reports, filed from a shared offer link where the visitor
      // is usually signed out — so creates are open but shape-checked;
      // everything else stays owner-or-admin.
      match /reports/{reportId} {
        allow create: if request.resource.data.keys().hasAll([
          'offerId', 'offerTitle', 'reason', 'note', 'status', 'createdAt',
        ])
          && request.resource.data.offerId is string
          && request.resource.data.offerId.size() > 0
          && request.resource.data.offerId.size() < 128
          && request.resource.data.offerTitle is string
          && request.resource.data.offerTitle.size() > 0
          && request.resource.data.offerTitle.size() < 120
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() < 120
          && request.resource.data.note is string
          && request.resource.data.note.size() < 500
          && request.resource.data.status == 'open';
        allow get, list: if signedIn()
          && (request.auth.uid == uid || isAdmin());
        allow update, delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());
      }

      // The shop's inbox — written by the admin verdict actions, read and
      // marked-read by the merchant. One exception: filing a report also
      // writes its "New customer report" notification in the same batch.
      // The notification reuses the report's doc id, and its title and
      // body must be exactly the derived values, so a report can carry
      // nothing into the inbox beyond the report itself.
      match /notifications/{notificationId} {
        function pairedReport() {
          return getAfter(
            /databases/$(database)/documents/shops/$(uid)/reports/$(notificationId),
          ).data;
        }
        allow get, list: if signedIn()
          && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && (request.auth.uid == uid || isAdmin())
          || (
            request.resource.data.keys().hasAll([
              'kind', 'title', 'body', 'at', 'read',
            ])
            && request.resource.data.kind == 'report'
            && request.resource.data.title == 'New customer report'
            && request.resource.data.read == false
            && pairedReport().status == 'open'
            && pairedReport().reason is string
            && pairedReport().reason.size() > 0
            && pairedReport().offerTitle is string
            && pairedReport().offerTitle.size() > 0
            && request.resource.data.body
              == pairedReport().reason + ' · ' + pairedReport().offerTitle
          );
        allow update, delete: if signedIn()
          && (request.auth.uid == uid || isAdmin());
      }

      // Raw view events from the public landing — one append-only doc per
      // open, the day + weekday-hour buckets the insights ranges aggregate.
      // Creates are open (visitors are usually signed out) but shape-checked
      // and clock-locked: `at` must be the server's own write time, so
      // nothing can forge when a view happened. Readable by the shop or an
      // admin; immutable once written.
      match /views/{eventId} {
        allow create: if request.resource.data.keys().hasAll([
            'offerId', 'day', 'hour', 'at',
          ])
          && request.resource.data.offerId is string
          && request.resource.data.offerId.size() > 0
          && request.resource.data.offerId.size() < 128
          && request.resource.data.day is string
          && request.resource.data.day.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.hour is string
          && request.resource.data.hour.matches('^(Sun|Mon|Tue|Wed|Thu|Fri|Sat)-(0?[0-9]|1[0-9]|2[0-3])$')
          && request.resource.data.at == request.time;
        allow get, list: if signedIn()
          && (request.auth.uid == uid || isAdmin());
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // The public feed mirror — one doc per offer a customer may see,
    // maintained by the owning merchant (or an admin) through feed.ts.
    // Carries marketing fields only: shop name/category/photo, the deal,
    // terms, dates and the pin coordinates — no phones, no owner names,
    // no GSTIN, no review notes. Anyone at all may read it (guests browse
    // the customer app); writes stay with the mirror's own shop or an
    // admin. Views are counted in shops/{uid}/views, never here.
    match /feed/{mirrorId} {
      allow read: if true;
      // The owning merchant writes their own mirrors; admins may create
      // mirrors when they approve an offer (the doc did not exist before),
      // which the owning-merchant-only create rule used to block.
      allow create: if signedIn()
        && (isAdmin() || request.resource.data.shopUid == request.auth.uid);
      allow update, delete: if signedIn()
        && (isAdmin() || resource.data.shopUid == request.auth.uid);
    }

    // Claimed coupons — one doc per coupon, the doc id IS the code
    // (`coupons/NZ-7Q4K-29XB`), so a scan is a single get and the merchant
    // scanner never runs a query. The customer creates their own claim and
    // can read it back; the shop that issued it marks it used (and can put
    // it back during the scanner's undo window). Nothing is ever deleted.
    match /coupons/{code} {
      // A code is unguessable (32^7) and worth nothing without the shop.
      allow get: if signedIn();
      // Lists are pinned to the caller: a customer sees their own coupons,
      // a shop sees the ones it issued.
      allow list: if signedIn()
        && (resource.data.customerUid == request.auth.uid
          || resource.data.shopUid == request.auth.uid
          || isAdmin());
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.usedAt == null
        && request.resource.data.keys().hasAll([
             'shopUid', 'shopName', 'offerId', 'offerTitle', 'customerUid',
             'claimedAt', 'endsAt', 'usedAt', 'usedBy',
           ]);
      allow update: if signedIn()
        && (resource.data.shopUid == request.auth.uid || isAdmin())
        // The shop may only flip the used fields — the coupon itself is
        // immutable, so a scan can't rewrite what was bought.
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.shopUid == resource.data.shopUid
        && request.resource.data.offerId == resource.data.offerId
        && request.resource.data.claimedAt == resource.data.claimedAt;
      allow delete: if false;
    }

    // Nothing outside the shops tree is reachable — and note: this wildcard
    // gates every collection-group query (it can match any candidate path),
    // so admin group reads live or die by isAdmin() right here.
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
